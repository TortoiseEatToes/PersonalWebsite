@inherits LayoutComponentBase

@using PersonalWebsite.Components.Custom

<FluentLayout>
    <PersonalHeader ProjectsAppearance="@ProjectsAppearance"
                    CareerAppearance="@CareerAppearance"
                    ContactAppearance="@ContactAppearance"/>
    <FluentStack Class="main" Orientation="Orientation.Horizontal">
        <FluentBodyContent Class="body-content">
            <div class="content">
                @Body
            </div>
        </FluentBodyContent>
    </FluentStack>
    <PersonalFooter></PersonalFooter>
</FluentLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    public virtual Appearance ProjectsAppearance { get; } = Appearance.Neutral;

    public virtual Appearance CareerAppearance { get; } = Appearance.Neutral;

    public virtual Appearance ContactAppearance { get; } = Appearance.Neutral;
}
