@page "/Blog"
@page "/Blog/{Filter}"

<PageTitle>Blog</PageTitle>

<MudStack>
	<BlogBlock Title="Website hosting on GitHub" CreationDate=DateTime.Now Filter=@Filter>
		<BlogHeader>
			<MudText>For this project, I wanted to use Blazor to create my own website with minimal hosting coosts.</MudText>
			<MudText>This solution that you see on this page is where I am currrently with MudBlazor using Blazor WASM and hosting on GitHub pages.</MudText>
		</BlogHeader>

		<BlogBody>
			<MudText>Pros</MudText>
			<MudText>Free hosting!!</MudText>
			<MudText>GitHub Action support</MudText>
			<MudText>MudBlazor UI framework</MudText>

			<MudText>Cons</MudText>
			<MudText>Load times - The loading animation while cute is there to hide the time it takes for Blazor to inject itself</MudText>
			<MudText>Page navigation is technically done by rerouting off of the GitHub 404 page lol</MudText>
			<MudText>Metadata on properly works on the home page</MudText>

			<MudText>How I did this</MudText>
			<MudLink Href="https://mudblazor.com/getting-started/installation#using-templates">Mud Blazor Getting Startd</MudLink>
			<MudLink Href="https://learn.microsoft.com/en-us/aspnet/core/blazor/host-and-deploy/webassembly/github-pages?view=aspnetcore-10.0">Blazor host and depoy</MudLink>
			<MudText>Lessons learned</MudText>
		</BlogBody>
	</BlogBlock>

	<BlogBlock Title="SaraTest" Filter=@Filter>
		<BlogHeader>
			<MudText>Sara testing block header</MudText>
		</BlogHeader>

		<BlogBody>
			<MudText>Sara testing block body</MudText>
		</BlogBody>
	</BlogBlock>
</MudStack>

@code {
	[Parameter]
	public string? Filter { get; set; } = "SaraTest";
}
