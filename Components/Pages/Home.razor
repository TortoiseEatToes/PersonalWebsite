@page "/"

<PageTitle>Home</PageTitle>

<MudStack Justify=@Justify.Center>
	<div class="center">
		<MudText Typo="Typo.h5" style="max-width: 90%">I'm Sara Asmussen and I make software tools and systems! I'm currently working on Diablo V.</MudText>
	</div>

	<MudGrid Class="d-flex flex-grow-1" Justify=Justify.Center>
		<MudItem Class="d-flex flex-grow-1" md="6" id="D5">
			<HomeShowcaseBlock Title="Diablo V" DescriptionBlocks=@Diablo5Description Href="/projects/diablo-five">
				<YouTubeEmbed Source="https://www.youtube.com/embed/GxCN_AKYtts?si=s4NERdYbYDMN4CQP" />
			</HomeShowcaseBlock>
		</MudItem>

		<MudItem Class="d-flex flex-grow-1" md="6" id="D4">
			<HomeShowcaseBlock Title="Diablo IV" DescriptionBlocks=@Diablo4Description Href="/projects/diablo-four">
				<YouTubeEmbed Source="https://www.youtube.com/embed/3t1WJsFXY-8?si=p-J05T7OyCSLeY0u" />
			</HomeShowcaseBlock>
		</MudItem>

		<MudItem Class="d-flex flex-grow-1" md="6" id="HungryHungryHamsters">
			<HomeShowcaseBlock Title="Hungry Hungry Hamsters" DescriptionBlocks=@HungryHungryDescription>
				<LinkedImage Href="https://ninehearts.itch.io/hamsters" Source="images/HungryHungryHamsters.png" />
			</HomeShowcaseBlock>
		</MudItem>

		<MudItem Class="d-flex flex-grow-1" md="6" id="GardenOfReverie">
			<HomeShowcaseBlock Title="Garden Of Reverie" DescriptionBlocks=@GardenOfReverieDescription>
				<LinkedImage Href="https://tortoiseeattoes.itch.io/garden-of-reverie" Source="images/GardenOfReverie.png" />
			</HomeShowcaseBlock>
		</MudItem>

		<MudItem Class="d-flex flex-grow-1" md="6" id="DesperateMeasures">
			<HomeShowcaseBlock Title="Desperate Measures" DescriptionBlocks=@DesperateMeasuresDescription>
				<LinkedImage Href="https://tortoiseeattoes.itch.io/desperate-measures" Source="images/DesperateMeasures.png" />
			</HomeShowcaseBlock>
		</MudItem>
	</MudGrid>
</MudStack>


@code {
	private readonly List<string> Diablo5Description = ["I started working fully on Diablo 5 in 2025.", 
														"I've done a bunch of work on our automated testing framework."];

	private readonly List<string> Diablo4Description = ["I started on Diablo 4 back in 2020.", 
														"Mention the digital foundry video and the game jam."];

	private readonly List<string> HungryHungryDescription = ["Blizzard game jam"];

	private readonly List<string> GardenOfReverieDescription = [@"This is our desynchronous game jame game where we made a multiplayer game with no real time networking component."];

	private readonly List<string> DesperateMeasuresDescription = ["First game jam where I experimented with pikmin player controller."];
}