<MudGrid>
	<MudItem class="">
		<MudCard Elevation=@Elevation Class=@Class>
			<MudCardHeader>
				<MudText Color="Color.Success">Pros</MudText>
			</MudCardHeader>
			<MudCardContent>
				@Pros
			</MudCardContent>
		</MudCard>
	</MudItem>
	<MudItem>
		<MudCard Elevation=@Elevation Class=@Class>
			<MudCardHeader>
				<MudText Color="Color.Error">Cons</MudText>
			</MudCardHeader>
			<MudCardContent>
				@Cons
			</MudCardContent>
		</MudCard>
	</MudItem>
</MudGrid>

@code {
	[Parameter]
	public RenderFragment? Pros { get; set; }

	[Parameter]
	public RenderFragment? Cons { get; set; }

	[Parameter]
	public int Elevation { get; set; } = 5;

	private string? Class { get; set; } = "d-flex align-center justify-center mud-width-full py-8";
}
