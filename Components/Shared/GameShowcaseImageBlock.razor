<MudPaper style="width: 100%; height: 100%">
	<MudStack style="margin: 20px;">
		<MudText Typo="Typo.h5" style="text-align: center;">@Title</MudText>
		<div class="center">
			@ChildContent
		</div>
		@foreach (var description in DescriptionBlocks)
		{
			<MudText Typo="Typo.body1" style="text-align: center;">@description</MudText>
		}
	</MudStack>
</MudPaper>

@code {
	[Parameter]
	public string Title { get; set; } = "Title not set";

	[Parameter]
	public List<string> DescriptionBlocks { get; set; } = [];

	[Parameter]
	public RenderFragment? ChildContent { get; set; }
}
