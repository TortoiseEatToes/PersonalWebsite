
<div class="center">
	<MudCard style="width: 90%; max-width: 1200px">
		<MudStack style="margin-bottom: 10px; margin-left: 10px; margin-right: 10px;">
			<h1 style="text-align: center;">@Title</h1>
			<div class="center">
				@ChildContent
			</div>
			@foreach (var description in DescriptionBlocks)
			{
				<p style="text-align: center;">@description</p>
			}
		</MudStack>
	</MudCard>
</div>

@code {
	[Parameter]
	public string Title { get; set; } = "Title not set";

	[Parameter]
	public List<string> DescriptionBlocks { get; set; } = [];

	[Parameter]
	public RenderFragment? ChildContent { get; set; }
}
