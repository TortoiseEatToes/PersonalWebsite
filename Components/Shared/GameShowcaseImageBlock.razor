<MudPaper Class="d-flex flex-grow-1">
	<MudStack Class="d-flex flex-grow-1 ma-5">
		<MudText Typo="Typo.h5" style="text-align: center;">@Title</MudText>
		<div class="center">
			@ChildContent
		</div>
		@foreach (var description in DescriptionBlocks)
		{
			<MudText style="text-align: center;">@description</MudText>
		}
	</MudStack>
</MudPaper>

@code {
	[Parameter]
	public string Title { get; set; } = "Title not set";

	[Parameter]
	public List<string> DescriptionBlocks { get; set; } = [];

	[Parameter]
	public RenderFragment? ChildContent { get; set; }
}
