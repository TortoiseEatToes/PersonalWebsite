

<MudCard>
	<MudStack >
		<MudButton OnClick="@OnButtonClick">
			<h3>@Company</h3>
		</MudButton>
		@if (@Revealed)
		{
			<MudStack Row="@true">
				<strong>@Role</strong>
				<MudSpacer></MudSpacer>
				<strong>@DateRange</strong>
			</MudStack>
			<div>@ChildContent</div>
		}
	</MudStack>
</MudCard>


@code {
	[Parameter]
	public string Company { get; set; } = "Company not set";

	[Parameter]
	public string Role { get; set; } = "Role not set";

	[Parameter]
	public string DateRange { get; set; } = "Date range not set";

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	private bool Revealed { get; set;}

	private void OnButtonClick()
	{
		Revealed = !Revealed;
	}
}
