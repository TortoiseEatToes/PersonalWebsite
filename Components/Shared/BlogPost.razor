@if (!IsContentShown())
{
	return;
}

<MudCard id=@ContentId Class="d-flex flex-grow-1">
	<MudCardHeader Class="d-flex flex-grow-1">
		<MudStack Class="d-flex flex-grow-1">
			<MudText Typo=Typo.h4>@Title</MudText>
			<MudText Typo=Typo.h6>Date: @CreationDate.ToString("MMMM dd, yyyy")</MudText>
		</MudStack>
	</MudCardHeader>

	<MudCardContent Class="d-flex flex-grow-1">
		<MudStack Class="d-flex flex-grow-1">
			@BlogHeader
			@if (IsFilterUsed())
			{
				<MudDivider />
				@BlogBody
			}
		</MudStack>
	</MudCardContent>

	@if (!IsFilterUsed())
	{
		<MudCardActions>
			<MudButton Href=@GetHrefPath() Variant=Variant.Filled Color=Color.Primary>Read More</MudButton>
		</MudCardActions>
	}
</MudCard>

@code {
	[Parameter]
	public string Title { get; set; } = "Title not set";

	[Parameter]
	public DateTime CreationDate { get; set; } = DateTime.Now;

	[Parameter]
	public string? Filter { get; set; }

	[Parameter]
	public RenderFragment? BlogHeader { get; set; }

	[Parameter]
	public RenderFragment? BlogBody { get; set; }

	private string ContentId = "NotSet";

	protected override void OnInitialized()
	{
		ContentId = Title.Replace(" ", "-").ToLower();
	}

	private bool IsFilterUsed()
	{
		return Filter is not null;
	}

	private bool IsContentShown()
	{
		return !IsFilterUsed() || Filter == ContentId;
	}

	private string GetHrefPath()
	{
		return $"blog/{ContentId}";
	}
}