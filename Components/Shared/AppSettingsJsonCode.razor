<MudButton Variant="Variant.Outlined"
           Color="Color.Tertiary"
           OnClick=@OnClicked
           style=@GetStyle()>
    @if (Expanded)
    {
        <code style="text-align: left;">
{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/_framework/debug/ws-proxy?browser={browserInspectUri}",
      "applicationUrl": "http://localhost:5078",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "commandLineArgs": "--pathbase=/LocalWebsite",
      "launchUrl": "LocalWebsite"
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/_framework/debug/ws-proxy?browser={browserInspectUri}",
      "applicationUrl": "https://localhost:7298;http://localhost:5078",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "commandLineArgs": "--pathbase=/LocalWebsite",
      "launchUrl": "LocalWebsite"
    }
  }
}
        </code>
    }
    else
    {
        <MudText>Show full code</MudText>
    }
</MudButton>

    @code {
    private bool Expanded = false;

    private string? GetStyle()
    {
        return Expanded ? "width: clamp(200px, 80%, 1200px);" : "width:200px";
    }

    private void OnClicked()
    {
        Expanded = !Expanded;
    }
}
