
<div class="hide-on-mobile">
    <MudStack Justify="Justify.Center">
        <HomeButton />
        <MudStack Row="@true" Justify="Justify.Center">
            @foreach (var subpage in subPages)
            {
                <MudLink Href="@subpage.Href" title="@subpage.Title">@subpage.Text</MudLink>
            }
        </MudStack>
    </MudStack>
</div>

<div class="hide-on-desktop">
    <MudStack Justify="Justify.Center">
        <HomeButton />
        <MudStack Row="@true" Justify="Justify.Center">
            @foreach (var subpage in subPages)
            {
                <MudLink Href="@subpage.Href" title="@subpage.Title">@subpage.Text</MudLink>
            }
        </MudStack>
    </MudStack>
</div>


@code {

    private List<SubPage> subPages = [
        new (){ Href = "Projects", Title = "Projects Page", Text = "Projects"},
        new (){ Href = "AboutMe", Title = "AboutMe Page", Text = "AboutMe"},
        new (){ Href = "Career", Title = "Career Page", Text = "Career"},
        new (){ Href = "Blog", Title = "Blog Page", Text = "Blog"},
    ];

    private class SubPage
    {
        public required string Href { get; set; }
        public required string Title { get; set; }
        public required string Text { get; set; }
    }
}
