
<div class="hide-on-mobile">
    <FluentStack VerticalAlignment="VerticalAlignment.Center">
        <HomeButton />
        <FluentStack VerticalAlignment="VerticalAlignment.Center" HorizontalAlignment="HorizontalAlignment.Right">
            @foreach (var subpage in subPages)
            {
                <FluentAnchor Href="@subpage.Href" title="@subpage.Title" Appearance="@ProjectsAppearance">@subpage.Text</FluentAnchor>
            }
        </FluentStack>
    </FluentStack>
</div>

<div class="hide-on-desktop">
    <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center">
        <HomeButton />
        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center">
            @foreach (var subpage in subPages)
            {
                <FluentAnchor Href="@subpage.Href" title="@subpage.Title" Appearance="@ProjectsAppearance">@subpage.Text</FluentAnchor>
            }
        </FluentStack>
    </FluentStack>
</div>


@code {
    [Parameter]
    public Appearance ProjectsAppearance { get; set; } = Appearance.Neutral;

    [Parameter]
    public Appearance CareerAppearance { get; set; } = Appearance.Neutral;

    private List<SubPage> subPages = [
        new (){ Href = "Projects", Title = "Projects Page", Text = "Projects"},
        new (){ Href = "AboutMe", Title = "AboutMe Page", Text = "AboutMe"},
        new (){ Href = "Career", Title = "Career Page", Text = "Career"},
        new (){ Href = "Blog", Title = "Blog Page", Text = "Blog"},
    ];

    private class SubPage
    {
        public required string Href { get; set; }
        public required string Title { get; set; }
        public required string Text { get; set; }
    }
}
