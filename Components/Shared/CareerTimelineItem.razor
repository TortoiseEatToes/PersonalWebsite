<MudTimelineItem TimelineAlign="TimelineAlign.End">
	<ItemOpposite>
		<MudText Color="Color.Info" Typo="Typo.h5">@DateRange</MudText>
		<MudText Color="Color.Info" Typo="Typo.h5">@Position</MudText>
	</ItemOpposite>

	<ItemContent>
		<MudCard Outlined="true" Elevation="25">
			<MudText Typo="Typo.h6" Align="Align.Center">@Company</MudText>
			@ChildContent
		</MudCard>
	</ItemContent>
</MudTimelineItem>

@code {
	[Parameter]
	public string Company { get; set; } = "Company not set";

	[Parameter]
	public string Position { get; set; } = "Position not set";

	[Parameter]
	public string DateRange { get; set; } = "DateRange not set";

	[Parameter]
	public RenderFragment? ChildContent { get; set; }
}
