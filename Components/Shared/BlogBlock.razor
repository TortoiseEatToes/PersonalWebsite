<MudCard>
	<MudStack >
		<MudButton OnClick="@OnButtonClick">
			@Title
		</MudButton>
		@if (@Revealed)
		{
			<div>@ChildContent</div>
		}
	</MudStack>
</MudCard>


@code {
	[Parameter]
	public string Title { get; set; } = "Title not set";

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	private bool Revealed { get; set; }

	private void OnButtonClick()
	{
		Revealed = !Revealed;
	}
}