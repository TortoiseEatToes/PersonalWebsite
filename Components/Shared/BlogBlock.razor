@if (!IsContentShown())
{
	return;
}

<MudCard>
	<MudCardHeader>
		<MudText Typo=Typo.h6>@Title</MudText>
	</MudCardHeader>

	<MudCardContent>
		@ChildContent
	</MudCardContent>

	<MudCardActions>
		<MudButton Href=@GetHrefPath() Variant="Variant.Text" Color="Color.Primary">Read More</MudButton>
	</MudCardActions>
</MudCard>

@code {
	[Parameter]
	public string Title { get; set; } = "Title not set";

	[Parameter]
	public DateTime CreationDate { get; set; } = DateTime.Now;

	[Parameter]
	public string? Filter { get; set; }

	[Parameter]
	public RenderFragment? ChildContent { get; set; }

	private string ContentId = "NotSet";

	protected override void OnInitialized()
	{
		ContentId = Title.Replace(" ", "");
	}

	private bool IsContentShown()
	{
		return Filter is null || Filter == ContentId;
	}

	private string GetHrefPath()
	{
		return $"Blog/{ContentId}";
	}
}