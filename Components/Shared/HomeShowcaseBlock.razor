<MudPaper Class="d-flex flex-grow-1">
	<MudStack Class="d-flex flex-grow-1 ma-5">
		<MudText Typo="Typo.h5" style="text-align: center;">@Title</MudText>
		<div class="center">
			@ChildContent
		</div>
		@foreach (var description in DescriptionBlocks)
		{
			<MudText style="text-align: center;">@description</MudText>
		}
		<MudStack Class="d-flex">
			<MudText style="text-align: center;">My role</MudText>
			@if (!string.IsNullOrEmpty(Href))
			{
				<MudButton Href=@Href Variant=Variant.Filled Color=Color.Primary>Read More</MudButton>
			}
		</MudStack>
	</MudStack>
</MudPaper>

@code {
	[Parameter]
	public string Title { get; set; } = "Title not set";

	[Parameter]
	public List<string> DescriptionBlocks { get; set; } = [];

	[Parameter]
	public string Href { get; set; } = "";

	[Parameter]
	public RenderFragment? ChildContent { get; set; }
}
