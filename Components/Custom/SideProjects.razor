	<ProjectBox Title="Sola's mentoring">
		<Status>
			MVP due January 2026
		</Status>
		<Body>
			<p>
				Developing a Blazor website with a PostGres backend for a
				coworker who need helps managing her work mentoring
				program next January.
			</p>
		</Body>
	</ProjectBox>

	<ProjectBox Title="Game Jams (12+)">
		<Status>
			Never Ending <FluentIcon Value="@(new Icons.Regular.Size16.Heart())" />
		</Status>
