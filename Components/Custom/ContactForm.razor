@rendermode InteractiveServer

@inject IDialogService DialogService

<FluentCard>
	<FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center">
		<h3>Contact me</h3>
		<FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Center">
			<FluentTextField @bind-Value=FirstName Label="First Name"></FluentTextField>
			<FluentTextField @bind-Value=LastName Label="Last Name"></FluentTextField>
		</FluentStack>
		<FluentTextField @bind-Value=Email Minlength="4" Label="Email"></FluentTextField>
		<FluentTextField @bind-Value=Subject Minlength="4" Label="Subject"></FluentTextField>
		<FluentTextArea @bind-Value=Message Label="Message"></FluentTextArea>
		<FluentButton OnClick="@OnSubmit" Appearance="Appearance.Accent">Submit</FluentButton>
	</FluentStack>
</FluentCard>


@code {
	private string FirstName { get; set; } = string.Empty;
	private string LastName { get; set; } = string.Empty;
	private string Email { get; set; } = string.Empty;
	private string Subject { get; set; } = string.Empty;
	private string Message { get; set; } = string.Empty;

	private const string MessageTitle = "Email Result";

	private async Task OnSubmit()
	{
		try
		{
			await DialogService.ShowSuccessAsync("Email sent!", MessageTitle, "Okay");
		}
		catch(Exception exception)
		{
			DialogService.ShowError(exception.Message, MessageTitle, "Okay");
		}
	}
}
