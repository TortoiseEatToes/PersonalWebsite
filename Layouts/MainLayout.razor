@inherits LayoutComponentBase

@using PersonalWebsite.Layouts;

<FluentLayout>
    <PersonalHeader ProjectsAppearance="@ProjectsAppearance"
        CareerAppearance="@CareerAppearance"
        ContactAppearance="@ContactAppearance"/>
    <FluentStack Class="main" VerticalAlignment="VerticalAlignment.Center">
        <FluentBodyContent Class="body-content">
            <div class="content">
                @Body
                <br/>
                <PersonalFooter/>
            </div>
        </FluentBodyContent>
    </FluentStack>
</FluentLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected virtual Appearance ProjectsAppearance { get; } = DefaultAppearance;

    protected virtual Appearance CareerAppearance { get; } = DefaultAppearance;

    protected virtual Appearance ContactAppearance { get; } = DefaultAppearance;

    static protected Appearance ClickedAppearance { get; } = Appearance.Outline;

    static protected Appearance DefaultAppearance { get; } = Appearance.Neutral;
}
