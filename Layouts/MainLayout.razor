@inherits LayoutComponentBase

@using PersonalWebsite.Layouts;

<FluentStack Class="main">
    <FluentBodyContent Class="body-content">
        <div class="content">
            <FluentStack Orientation="Orientation.Vertical">
                <NavigationButtons ProjectsAppearance="@ProjectsAppearance"
                                   CareerAppearance="@CareerAppearance" />
                <FluentStack HorizontalAlignment="HorizontalAlignment.Center">
                    @Body
                </FluentStack>
            </FluentStack>
        </div>
    </FluentBodyContent>
</FluentStack>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    protected virtual Appearance ProjectsAppearance { get; } = DefaultAppearance;

    protected virtual Appearance CareerAppearance { get; } = DefaultAppearance;

    static protected Appearance ClickedAppearance { get; } = Appearance.Outline;

    static protected Appearance DefaultAppearance { get; } = Appearance.Neutral;
}
